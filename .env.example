# ============================================================
# Plantilla de Variables de Entorno - Producción (Arsys) / Local
# ============================================================
# Copia este archivo a ".env" en tu servidor o local y edita los valores.
# ¡IMPORTANTE!: No subas el archivo ".env" final con tus contraseñas reales a Git.

# URL base de la API (para desarrollo local)
VITE_API_URL=http://localhost/Portfolio

# Configuración de Base de Datos MySQL
# En Arsys, usa los datos proporcionados por tu panel de hosting de Arsys.
DB_HOST=localhost
DB_NAME=portfolio_db
DB_USER=root
DB_PASS=

# Credenciales del Administrador para el Panel
# Define aquí el usuario y contraseña que quieres usar para entrar a /admin
ADMIN_USER=RotaruX
ADMIN_PASS=CambiaEstaContrasenaPorUnaSegura123.

# Secreto para la generación de tokens de sesión (Cualquier texto largo y seguro)
ADMIN_TOKEN_SECRET=portfolio_admin_secure_token_2026

# CORS - Orígenes permitidos (opcional, separados por coma)
CORS_ORIGIN=http://localhost:5173,http://localhost/Portfolio
